# Parallel structure probe (2 harts): each claims a rank via amoadd on a zero-init
# counter, writes rank+1 to a shared slot, and the last finisher sums the slots
# (1+2 = 3) to the UART. No barriers.
rank_counter: global u32
done_counter: global u32
slots: global [u32]*2

fetch_add(a3, rank_counter, 1)

a4 = a3 + 1
t5 = 4
t0 = at(slots, a3, t5)
t0[0] = a4

# Release fence: make this hart's slot write globally visible BEFORE it bumps
# the done counter, so the finisher (which observes the bump) is guaranteed to
# see it. The verifier explores all interleavings under sequential consistency,
# but QEMU MTTCG is weakly ordered, so the fence is what makes the runtime
# agree with the proof (`fannkuch_v2` documents the same pattern).
asm:
    fence rw, rw
fetch_add(t2, done_counter, 1)
a0 = 1
if t2 == a0:
    t0 = &slots
    a5 = t0[0]
    t0 = t0 + 4
    a6 = t0[0]
    a5 = a5 + a6
    t3 = 0x10000000
    t4 = a5 + 48
    t3[0:1] = t4

asm:
    wfi
unreachable
