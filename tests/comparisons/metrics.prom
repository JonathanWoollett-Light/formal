# Language-comparison metrics backing the index.html comparison panels.
# GENERATED, like Cargo.lock: committed, but written by the test suite, not
# by hand. `BLESS=1 cargo nextest run --run-ignored all comparisons`
# re-measures every language whose pinned toolchain is installed and
# rewrites this file plus the page (FORMAL_COMPARISONS_FULL=1 adds the
# heavy fannkuch-redux runtime runs); the normal run re-measures and
# asserts this file still matches (see tests/comparisons/main.rs for the
# per-metric comparison policy). origin="legacy" marks values inherited
# from the pre-pipeline experiment (a different environment than recorded
# below); the first BLESS run with the language's toolchain replaces them.
# HELP formal_comparison_environment_info The controlled environment the measured samples were taken under (in the labels; the value is always 1).
# TYPE formal_comparison_environment_info gauge
formal_comparison_environment_info{binutils="2.42",gnat="13.3.0",host="Intel(R) Xeon(R) Processor @ 2.80GHz (4 cores)",os="Ubuntu 24.04.4 LTS, Linux 6.18.5",qemu="8.2.2",rustc="1.99.0-nightly (9f36de775 2026-07-19)"} 1
# HELP formal_comparison_compile_seconds Wall-clock seconds to compile the program with the language's pinned toolchain (cold output directory, warm toolchain caches).
# TYPE formal_comparison_compile_seconds gauge
formal_comparison_compile_seconds{program="hello",language="formal",origin="measured"} 0.015
formal_comparison_compile_seconds{program="hello",language="rust",origin="measured"} 40.030
formal_comparison_compile_seconds{program="hello",language="ada",origin="measured"} 0.300
formal_comparison_compile_seconds{program="fannkuch",language="formal",origin="measured"} 0.728
formal_comparison_compile_seconds{program="fannkuch",language="rust",origin="measured"} 25.378
formal_comparison_compile_seconds{program="fannkuch",language="ada",origin="measured"} 0.339
