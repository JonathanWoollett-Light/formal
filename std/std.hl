# The formal standard library (working name; minimal for now). The compiler
# prepends this file to every program it compiles, so these definitions are
# available everywhere. A `def` emits no code until it is called, so an unused
# prelude costs nothing: a program that never calls anything here lowers exactly
# as if this file were not there.
#
# Every function is inlined into the caller's register file, so its clobber
# list is part of its contract: a register named there is overwritten by the
# call. A register argument that is also a clobber is read before it is
# overwritten, except where the comment says otherwise.
#
# Several `def`s of one name are overloads: a call takes the one whose
# parameter types match its argument's categories (a string or a variable name
# is an array; an integer or a register is a scalar), resolved at compile time.

# print(msg): write a value to standard output (Linux `write(2)`, fd 1). The two
# overloads make `print` polymorphic over its argument, resolved at compile
# time: `print("hi")` lowers to the string walk and `print(42)` to the integer
# formatter, with no runtime type check and no separate `print_int`.
#
# Targets **Linux** (a hosted RISC-V process): it uses `ecall`, so a bare-metal
# program (no OS to answer the `ecall`) must write to its device directly (see
# the `uart_hello` test, which pokes the QEMU UART with raw assembly).

# Any array (a string literal, or a variable holding a NUL-terminated
# string): walk to the first zero byte, then write up to it. Clobbers a0, a1,
# a2, a7, t0.
def print(msg: [..]):
    a1 = &msg
    a2 = 0
    t0 = a1[0]
    while t0 != 0:
        a2 = a2 + 1
        a1 = a1 + 1
        t0 = a1[0]
    a0 = 1
    a1 = &msg
    a7 = 64
    asm:
        ecall

# An integer: peel decimal digits off the back of a scratch buffer (div/rem),
# convert each to ASCII, and write the slice. Assumes a non-negative value: a
# negative one formats its digits from a negative remainder and prints
# punctuation, so signed handling is still future work. Clobbers a0, a1, a2,
# a7, t0, t1, t2, t5.
def print(msg: i64):
    t5 = msg
    __print_buf: thread [u8]*20
    t0 = &__print_buf
    t0 = t0 + 20
    t1 = 10
    a2 = 0
    # Zero has no digits to peel, so the loop below would leave the slice
    # empty and `print(0)` would write nothing at all. Lay its one digit
    # down first; the loop then does not run.
    if t5 == 0:
        t2 = 48
        t0 = t0 - 1
        t0[0] = t2
        a2 = a2 + 1
    while t5 != 0:
        t2 = t5 % t1
        t5 = t5 / t1
        t2 = t2 + 48
        t0 = t0 - 1
        t0[0] = t2
        a2 = a2 + 1
    a1 = t0 + 0
    a0 = 1
    a7 = 64
    asm:
        ecall

# println(x): `print(x)` followed by a newline. Takes whatever `print` takes.
# Clobbers what `print` does: a0, a1, a2, a7, t0, and for an integer t1, t2, t5.
def println(x):
    print(x)
    print("\n")

# exit(code): end the process with the Linux `exit` system call (syscall 93).
# Like `print` this targets Linux (it uses `ecall`); the call never returns, so
# the body ends in `unreachable`. `exit(0)` is the clean way to finish a hosted
# program (see the `linux_hello` test). Clobbers a0, a7.
def exit(code: i64):
    a0 = code
    a7 = 93
    asm:
        ecall
    unreachable

# at([arr, i, size]): the address of element i of the variable arr, with
# elements `size` bytes wide. `size` and `i` are registers (there is no
# multiply-immediate). The element is then read or written through the
# result with `p[0]`. Clobbers t0 and t1; leaves the byte offset in t1, which
# `at_offset` reuses for a parallel array. Do not pass t0 as `i` (the result
# overwrites it before it is used).
def at([arr, i, size]: [[..], i64, i64]):
    t1 = i * size
    t0 = &arr
    return t0 + t1

# at_offset([arr, off]): the address `off` bytes into the variable arr: a byte
# array's element `off`, or the offset a preceding `at` left in t1 (the same
# element of a parallel array). Clobbers t0.
def at_offset([arr, off]: [[..], i64]):
    t0 = &arr
    return t0 + off

# mod([k, cap]): Python's `%`, the canonical non-negative remainder
# ((k % cap) + cap) % cap. RISC-V `rem` takes the dividend's sign, so a bare
# `%` on a negative key indexes a table backwards. `cap` is a register (no
# remainder-immediate). Clobbers t3.
def mod([k, cap]: [i64, i64]):
    t3 = k % cap
    t3 = t3 + cap
    return t3 % cap

# fetch_add([old, counter, v]): old = counter; counter = counter + v, in one
# atomic step (`amoadd.w`), the lock-free way harts claim a rank from a shared
# u32 counter. `old` is the register that receives the previous value (an asm
# line cannot be a `return`, so it is an argument); `v` is a register or an
# integer. Clobbers t0, t1 and writes old. Bare-metal and Linux alike.
def fetch_add([old, counter, v]: [i64, [..], i64]):
    t0 = &counter
    t1 = v
    asm:
        amoadd.w old, t1, (t0)
